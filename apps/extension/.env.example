# Copy to .env.local for development. Unlike the dashboard, the extension's
# Vite config reads env files from this directory, not the repo root.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_DASHBOARD_URL=http://localhost:5173

# PostHog (analytics). Leave blank to disable analytics entirely — the service
# worker skips every send and the panel's track() calls become no-ops.
# Use the same project as the dashboard so a student is one person across both;
# the `platform` and `environment` properties separate the traffic.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Public privacy policy URL, shown next to the opt-out toggle in the panel.
# Must match the URL on the Chrome Web Store listing. Blank hides the link.
VITE_PRIVACY_POLICY_URL=

# Production values go in .env.production, which `bun run pack` reads.
