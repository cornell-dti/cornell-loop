{
  "manifest_version": 3,
  "name": "Cornell Loop",
  "version": "0.0.1",
  "key": "",
  "action": {
    "default_title": "Cornell Loop",
    "default_icon": {
      "16": "loop_logo.png",
      "32": "loop_logo.png",
      "48": "loop_logo.png",
      "128": "loop_logo.png"
    }
  },
  "icons": {
    "16": "loop_logo.png",
    "32": "loop_logo.png",
    "48": "loop_logo.png",
    "128": "loop_logo.png"
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*", "https://calendar.google.com/*"],
      "js": ["src/content.tsx"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "identity", "tabs"],
  "host_permissions": ["https://*.convex.cloud/*", "https://*.convex.site/*"]
}
