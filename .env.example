# Copy to .env.local and fill in. `npx convex dev` writes the Convex values.
# This file lives at the repo root because the dashboard's Vite config sets
# `envDir: "../../"` — env files inside apps/dashboard are not read.
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=
VITE_CONVEX_SITE_URL=
VITE_DASHBOARD_URL=

# PostHog (analytics). Leave blank to disable analytics entirely — the app
    10|# skips posthog.init and every track() call becomes a no-op.
# Use a separate PostHog project for development so local traffic stays out of
# production metrics.
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Set on the Convex deployment (not here) for server-side `account_created`:
#   npx convex env set POSTHOG_KEY phc_...
#   npx convex env set POSTHOG_HOST https://us.i.posthog.com
